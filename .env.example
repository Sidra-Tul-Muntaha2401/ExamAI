# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Recommended for production persistence.
# Use your Supabase Project API URL (https://<project-ref>.supabase.co), not the db.* host.
# Find these in Supabase Project Settings -> API (keep service_role key strictly server-side).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional public browser Supabase Auth configuration (never put service_role key here!)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SESSION_SECRET: Random 32+ char string for signing HttpOnly session cookies in production.
SESSION_SECRET=

# Optional Admin Provisioning (ADMIN_PASSWORD must be 8+ characters; if unset, claim once via /admin-setup)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_BOOTSTRAP_SECRET=

# Demo quick-login accounts: disabled by default in all environments unless ENABLE_DEMO_LOGIN="true".
DISABLE_DEMO_LOGIN="true"

# GROQ_API_KEY: Primary API key for server-side AI question generation via Groq API.
GROQ_API_KEY=

# GROQ_MODEL: Optional override for the Groq chat completion model.
GROQ_MODEL="openai/gpt-oss-120b"

# GEMINI_API_KEY: Optional fallback API key for server-side AI question generation via Gemini.
GEMINI_API_KEY=

# DATABASE_PATH: Local SQLite fallback path used when Supabase env vars are not configured.
DATABASE_PATH="./data/exampilot.sqlite"

# APP_URL: The public HTTPS origin where this application is hosted (used in confirmation/reset emails).
APP_URL="http://localhost:3000"
