# GROQ_API_KEY: Required for server-side AI question generation via Groq API.
# Obtain a key from https://console.groq.com/ and set it here for local development.
GROQ_API_KEY=

# GROQ_MODEL: Optional override for the Groq chat completion model.
GROQ_MODEL="llama-3.3-70b-versatile"

# SESSION_SECRET: Optional secret for signing session tokens (falls back to random key in memory).
SESSION_SECRET=

# DATABASE_PATH: Local SQLite database file path.
DATABASE_PATH="./data/exampilot.sqlite"

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"
